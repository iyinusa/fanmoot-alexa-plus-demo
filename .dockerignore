# Keep the build context small and secrets out of the image.
.git
.github
.gitignore
__pycache__
*.py[cod]
.venv
venv
.env
.env.*
!.env.example
.mypy_cache
.ruff_cache
.pytest_cache
.coverage
htmlcov
.DS_Store
.idea
.vscode

# The SPA is built inside the image's Node stage. A host node_modules is slow
# to send and built for the wrong platform, and a host-built bundle could
# silently stand in for the image's own.
web/node_modules
web/dist
app/static/web
*.tsbuildinfo
