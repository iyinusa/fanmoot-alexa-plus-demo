# fanmoot-alexa-plus-demo — every setting, with its default.
#
# Copy to .env for local development. In production passes these as
# environment variables through its UI (docker-compose.yml), and no .env exists.
# Every variable is prefixed FMD_.

# ── Environment & identity ──────────────────────────────────────────────────
# `production` switches the logs to JSON.
FMD_ENV=development
# This demo's own origin, no trailing slash. The one browser origin /ws always
# accepts. Production: https://alexaplus.fanmoot.com
FMD_PUBLIC_BASE_URL=http://localhost:8090

# ── The MCP server this demo drives ─────────────────────────────────────────
# The deployed server by default. For a fanmoot-mcp running locally with
# `make dev` there: http://127.0.0.1:8080/mcp — and from inside Docker,
# http://host.docker.internal:8080/mcp
FMD_MCP_URL=https://mcp.fanmoot.com/mcp

# ── /ws ─────────────────────────────────────────────────────────────────────
# More browser origins allowed to open /ws, comma-separated — a staging host,
# say. The demo's own origin is always allowed, and in development so is the
# Vite dev server on :5174.
FMD_WS_ALLOWED_ORIGINS=
# The largest frame a browser may send, in bytes.
FMD_WS_MAX_FRAME_BYTES=16384

# ── Visitor sessions (W1-1) ─────────────────────────────────────────────────
# Sessions held at once; how long a dropped socket's session waits to be
# resumed; how long an untouched one lives; turns per session (HAD-9).
FMD_MAX_SESSIONS=200
FMD_SESSION_GRACE_S=300
FMD_SESSION_IDLE_S=3600
FMD_SESSION_TURN_CAP=40
# One MCP request's ceiling, in seconds.
FMD_MCP_TIMEOUT_S=15
# MCP payloads bigger than this reach the trace panel as a preview.
FMD_TRACE_MAX_PAYLOAD_BYTES=24000

# ── The Alexa+ shell (W2) ───────────────────────────────────────────────────
# The corner ticker (W2-7): seconds between `live_scores` calls while a
# visitor is connected (0 turns it off), and between `upcoming_matches` calls
# when nothing is in play.
FMD_AMBIENT_INTERVAL_S=30
FMD_AMBIENT_IDLE_INTERVAL_S=300
# `tools/call`s the cards on screen may make in one session (W2-6).
FMD_VIEW_CALLS_PER_SESSION=30

# ── The model chain (HAD-9, W1-3) ───────────────────────────────────────────
# LiteLLM model ids, tried in order. Read every turn; PUT /api/admin/models
# reorders it on a running demo without a redeploy.
FMD_MODEL_CHAIN=bedrock/us.amazon.nova-pro-v1:0,bedrock/us.anthropic.claude-sonnet-4-6,gemini-3.1-flash-lite
# Bedrock. Empty keys mean the standard AWS chain (instance role, AWS_PROFILE,
# AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY). Model access is per account and
# per region: enable each model in the Bedrock console for this region.
FMD_AWS_REGION=us-east-1
FMD_AWS_ACCESS_KEY_ID=
FMD_AWS_SECRET_ACCESS_KEY=
FMD_AWS_SESSION_TOKEN=
# Gemini through Google AI Studio. Empty skips the Gemini rung.
FMD_GEMINI_API_KEY=
# One model call's limit in seconds; a provider slower than this is failed over.
FMD_MODEL_TIMEOUT_S=20
FMD_MODEL_TEMPERATURE=0.4
FMD_MODEL_MAX_OUTPUT_TOKENS=600
FMD_MAX_LLM_CALLS_PER_TURN=8
# Prices LiteLLM does not know: {"model id": [input, output]} in USD per 1M tokens.
FMD_MODEL_PRICES=
# Daily spend ceiling per provider, USD: {"bedrock": 25, "gemini": 5}.
FMD_PROVIDER_DAILY_CAP_USD=

# ── OAuth: how the demo signs a fan in (W1-7) ───────────────────────────────
# auto | static | metadata_document | dcr. `auto` uses a client ID metadata
# document on https (production) and Dynamic Client Registration on a laptop.
FMD_OAUTH_CLIENT_MODE=auto
FMD_OAUTH_CLIENT_ID=
FMD_OAUTH_CLIENT_SECRET=

# ── The demo fan (W1-8) ─────────────────────────────────────────────────────
# A real Fanmoot account visitors may post as. Empty hides the option.
FMD_DEMO_FAN_EMAIL=
FMD_DEMO_FAN_PASSWORD=
FMD_DEMO_FAN_LABEL=Demo fan account
FMD_DEMO_FAN_WRITES_PER_SESSION=5
FMD_DEMO_FAN_WRITES_PER_HOUR=30

# ── Operator ────────────────────────────────────────────────────────────────
# Bearer token for /api/admin/models. Empty: the routes answer 404.
FMD_ADMIN_TOKEN=
